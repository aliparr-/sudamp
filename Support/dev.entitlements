<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only for `make app-hardened` once an ad-hoc-signed framework (Sparkle, M8) is embedded:
	     an ad-hoc hardened binary cannot load an ad-hoc framework ("different Team IDs"). Never used for releases. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
