{
  "name": "EQ preset round trip through the presets menu (PLAN M5)",
  "description": "Rock from the presets menu, Save .eqf…, Flat, Load .eqf…: the gains come back equal. Pass the file with --automation's EQF path below.",
  "style": "classic",
  "steps": [
    {"pressControl": "eqPresets", "window": "equalizer"},
    {"waitForMenu": "presets", "timeout": 3},
    {"selectMenuItem": "Rock"},
    {"dumpState": "rock"},
    {"saveEQF": "/tmp/sudamp-eqf-roundtrip.eqf"},
    {"pressControl": "eqPresets", "window": "equalizer"},
    {"waitForMenu": "presets", "timeout": 3},
    {"selectMenuItem": "Flat"},
    {"dumpState": "flat"},
    {"loadEQF": "/tmp/sudamp-eqf-roundtrip.eqf"},
    {"dumpState": "loaded"}
  ]
}
